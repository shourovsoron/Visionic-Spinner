# MongoDB Atlas connection string (must point at a replica-set cluster so transactions work)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spin_and_win?retryWrites=true&w=majority

# Admin dashboard credentials (never exposed to the client)
ADMIN_USERNAME=admin_visionic
ADMIN_PASSWORD=Admin@BTPV1234

# Secret used to sign the admin session cookie (HMAC-SHA256). Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=replace_with_a_long_random_string

# Initial prize inventory used only by `npm run seed` on first run.
# Must satisfy: FLIGHT_TICKET_QTY + TSHIRT_QTY + COUPON_20_QTY + COUPON_15_QTY = 800
FLIGHT_TICKET_QTY=3
TSHIRT_QTY=10
COUPON_20_QTY=400
COUPON_15_QTY=387
